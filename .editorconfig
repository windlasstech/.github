[*]
# Non-configurable formatter behaviors
charset = utf-8
insert_final_newline = true
# Caveat: formatters won’t trim trailing whitespace inside template strings, but your editor might.
trim_trailing_whitespace = true

# Formatter behaviors (mirrors bunfig.toml [fmt])
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown hard breaks are trailing two spaces; editors must not strip them.
[*.md]
trim_trailing_whitespace = false
